<% layout("layouts/boilerplate") %>


<div class="container">
<h2>Show Details</h2>
<button onclick="window.history.back()" class="btn btn-dark mb-3 mt-3">Back</button>
<div class=" listing-card">
  <img class="card-img-top" src="<%= list.image?.url || '/images/airbnb.jpg' %>" alt="Listing image">

  <div class="card-body">
    <h5 class="card-title"><b><%= list.title %></b></h5>

    <p class="card-text">
      Price: ₹ <%= (list.price ?? 0).toLocaleString("en-IN") %>/night
    </p>

    <p class="card-text"><%= list.description %></p>

    <p class="card-text">
      <small class="text-muted">
        <%= list.location %>, <%= list.country %>
      </small>
    </p>
  </div>
</div>

<a href="/listings/<%= list._id %>/edit" class=" mb-3 btn btn-dark mt-3">Edit</a>
<a href="/listings/<%=list._id%>/delete" class=" mb-3 btn btn-dark mt-3">Delete</a> 
<hr>
<h3>Reviews</h3>
<div class=" mt-5">
  <form  action="/listings/<%= list._id %>/reviews" method="POST" novalidate class="needs-validation"> <!--client side validation-->
<div>
  <label for="rating">Rating:</label>
  <input type="range" id="rating" name="review[rating]" min="1" max="5" class="form-range" step="1" value="3">
</div>
<div ><label for="comment" class="mt-2 mb-2">Comment:</label>
  <textarea class="form-control" id="comment" name="review[comment]" rows="5" cols="30" placeholder="Enter your review here..." required></textarea>
  
  <div class="invalid-feedback">Please write a comment.</div>
</div>
<button type="submit" class="btn btn-dark mt-3 mb-3">Submit</button>  
  </form>
  <hr/>
  <div class="mt-3">
    <div class="row">
      
    <% if (list.reviews && list.reviews.length > 0) { %>
      <% list.reviews.forEach(review => { %>
        <div class="col-6 mb-3">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">Rating: <%= review.rating %>/5</h5>
              <p class="card-text"><%= review.comment %></p>
              <form method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');"  action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button type="submit" class="delbtn btn btn-dark btn-md" formaction="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE">Delete</button> 
              </form>
              <p class="card-text"><small class="text-muted">Posted on: <%= new Date(review.createdAt).toLocaleDateString() %></small></p>
            </div>
          </div>
        </div>
        
      <% }) %>
    <% } else { %>
      <p>No reviews yet.</p>
    <% } %>
    
  
</div>
</div>
</div>  

</div>
