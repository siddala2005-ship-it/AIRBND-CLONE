<% layout("layouts/boilerplate") %>

<div class="container py-4">
  <h3>Create a New Listing</h3>
  <button class="btn btn-dark mb-3" onclick="window.history.back()">Back</button>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/listings" method="POST" class="border p-4 mb-5 rounded shadow-sm needs-validation" novalidate>
    <div class="container p-4 mb-5 bg-light rounded">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="Listing[title]" value="<%= listingData.title || '' %>" required>
        <div class="invalid-feedback">Please provide a title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="Listing[description]" rows="3" required><%= listingData.description || '' %></textarea>
        <div class="invalid-feedback">Please provide a description.</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image URL</label>
        <input type="url" class="form-control" id="image" name="Listing[image][url]" value="<%= listingData.image?.url || '' %> " required>
        <div class="invalid-feedback">Please provide a valid image URL.</div>
      </div>

      <div class="row">
        <div class="col-6 mb-3">
          <label for="price" class="form-label">Price</label>
          <input type="number" min="0" class="form-control" id="price" name="Listing[price]" value="<%= listingData.price || '' %>" placeholder="Enter price" required>
          <div class="invalid-feedback">Please provide a valid price.</div>
          <% if (error && error.toLowerCase().includes('price')) { %>
            <div class="text-danger small mt-1"><%= error %></div>
          <% } %>
          <div class="invalid-feedback">Please provide a valid price.</div>
        </div>

        <div class="col-6 mb-3">
          <label for="country" class="form-label">Country</label>
          <input type="text" class="form-control" id="country" name="Listing[country]" value="<%= listingData.country || '' %>" required>
          <div class="invalid-feedback">Please provide a valid country.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input type="text" class="form-control" id="location" name="Listing[location]" value="<%= listingData.location || '' %>" placeholder="Enter location" required>
        <div class="invalid-feedback">Please provide a valid location.</div>
      </div>

      <button type="submit" class="btn btn-dark mt-3">Add Listing</button>
    </div>
  </form>
</div>
