<% layout("layouts/boilerplate") %>

<div class="container">
  <h3>Edit Listing</h3>
  <button onclick="window.history.back()" class="btn btn-dark mb-3">
    Back
  </button>

  <form action="/listings/<%= list._id %>?_method=PUT" method="POST">

    <div class="mb-3">
      <label class="form-label">Title:</label>
      <input class="form-control"
             type="text"
             name="Listing[title]"
             value="<%= list.title %>"
             required>
    </div>

    <div class="mb-3">
      <label class="form-label">Description:</label>
      <textarea class="form-control"
                name="Listing[description]"
                required><%= list.description %></textarea>
    </div>

    <div class="mb-3">
      <label class="form-label">Image URL:</label>
      <input class="form-control"
             type="text"
             name="Listing[image][url]"
             value="<%= list.image.url %>">
    </div>

    <div class="row">
      <div class="col-6 mb-3">
        <label class="form-label">Price:</label>
        <input class="form-control"
               type="number"
               name="Listing[price]"
               value="<%= list.price %>"
               required>
      </div>

      <div class="col-6 mb-3">
        <label class="form-label">Location:</label>
        <input class="form-control"
               type="text"
               name="Listing[location]"
               value="<%= list.location %>"
               required>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Country:</label>
      <input class="form-control"
             type="text"
             name="Listing[country]"
             value="<%= list.country %>"
             required>
    </div>

    <button type="submit" class="btn btn-dark">
      Update Listing
    </button>

  </form>
</div>